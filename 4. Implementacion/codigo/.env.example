# Copiá este archivo como ".env" y cambiá los valores.
# El archivo ".env" NO se sube al repositorio (RNF13).

# Clave con la que Flask firma la cookie de sesión. Obligatoria.
# Generá una con:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-larga-y-al-azar

# Cuánto dura una sesión abierta, en minutos.
DURACION_SESION_MINUTOS=60

# Opcional. Nombre del archivo de la base dentro de instance/.
# BASE_DE_DATOS=miblog.sqlite3